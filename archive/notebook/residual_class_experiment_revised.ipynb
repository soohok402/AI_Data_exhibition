   "source": "# ============================================================\n# 1. 컬럼군 정의\n# ============================================================\n\ntarget_col = 'target_maxrise_6h'  # 모델링 학습부터는 반드시 빼내야 함\n\n# 수위 컬럼군\nwl_cols = [\n    'wl_t',\n    'wl_t_minus_1h',\n    'wl_t_minus_3h',\n    'wl_t_minus_6h',\n    'wl_t_minus_12h',\n    'wl_t_minus_24h',\n]\n\n# 수위차분(wl_diff) 컬럼군\nwl_diff_cols = [\n    'wl_t',\n    'wl_diff_1h',\n    'wl_diff_3h',\n    'wl_diff_6h',\n    'wl_diff_12h',\n    'wl_diff_24h'\n]\n\n\n# 강수 컬럼군\nrain_cols = [\n    # IMERG강우\n    'imerg_rain_1h',\n    'imerg_rain_6h',\n    'imerg_rain_24h',\n    # 지상강우\n    'sfc_rain_1h',\n    'sfc_rain_6h',\n    'sfc_rain_24h',\n    # 레이더 반사도\n    'radar_reflectivity_mean',\n    'radar_reflectivity_p95',\n    'radar_reflectivity_ge20_fraction'\n]\n\n# 강우강도 컬럼군\nrain_int_cols = [\n    'imerg_rain_1h',\n    'imerg_int_1to6h',\n    'imerg_int_6to24h',\n    'sfc_rain_1h',\n    'sfc_int_1to6h',\n    'sfc_int_6to24h'\n]\n\n# 환경 컬럼군\nenv_cols = [\n    'cat_area',       # km²\n    'wsarea',         # km²\n    'mean_elevation', # m\n    'mean_slope',     # °\n    'urban_ratio',    # %\n    'forest_ratio',   # %\n    'stream_order'\n]\n\nnum_cols = wl_cols + rain_cols + env_cols\nnum_cols_fe_wl = num_cols + [\n    col for col in wl_diff_cols if col != 'wl_t'\n]\nnum_cols_fe = num_cols_fe_wl + [\n    col for col in rain_int_cols if col not in ['imerg_rain_1h', 'sfc_rain_1h']\n]\n\nprint(f\"\"\"<변수개수 검증>\n    수위변수: {len(wl_cols)}\n    강우변수: {len(rain_cols)}, \n    환경변수: {len(env_cols)}, \n    수위차분(wl_t포함): {len(wl_diff_cols)},\n    강우강도(rain_1h포함): {len(rain_int_cols)}\n    기존 숫자열(수위 + 강우 + 환경): {len(num_cols)}, \n    수위차분추가 숫자열(수위 + 강우 + 환경 + 수위차분(wl_t제외)): {len(num_cols_fe_wl)},\n    강우강도추가 숫자열(수위차분추가 숫자열 + 강우강도(rain_1h 2개제외)): {len(num_cols_fe)}\n\"\"\")\n",
   "execution_count": null,
