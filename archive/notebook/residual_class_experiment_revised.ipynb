    "            kf_fold_num.loc[b_train_ids], b_forbidden, f'B/class_fold_{fold_num}', b_log)\n",
    "        b_rounds.extend(rounds)\n",
    "        b_labels = residual_labels(y_train.loc[b_train_ids] - b_inner_pred, final_threshold)\n",
